# REQUIRED: create a NEW Discord bot token in the Discord Developer Portal.
DISCORD_TOKEN=replace_with_your_new_discord_bot_token
# Optional: only needed for commands/features that use Gemini.
GEMINI_API_KEY=replace_with_your_gemini_key
BOT_PREFIX=,
# Railway sets this automatically for the packaged Docker deployment; keep the value below.
BOT_DB_PATH=/app/data/bot.db
